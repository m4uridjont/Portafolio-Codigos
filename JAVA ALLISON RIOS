function initVideoPlayer() {
  const centerPlayBtn = document.getElementById('video-center-play-btn');
  const ctrlPlayBtn = document.getElementById('video-ctrl-play');
  const progressBar = document.getElementById('video-progress-fill');
  const timeDisplay = document.getElementById('video-time-display');
  const muteBtn = document.getElementById('video-ctrl-mute');

  let isPlaying = false;
  let currentTime = 14;
  const duration = 92; // 1:32 total

  function togglePlay() {
    isPlaying = !isPlaying;
    if (isPlaying) {
      if (centerPlayBtn) centerPlayBtn.style.display = 'none';
      if (ctrlPlayBtn) ctrlPlayBtn.textContent = '⏸';
      showToast('Reproduciendo: Mensaje de bienvenida de Allison Rios');
    } else {
      if (centerPlayBtn) centerPlayBtn.style.display = 'flex';
      if (ctrlPlayBtn) ctrlPlayBtn.textContent = '▶';
    }
  }

  if (centerPlayBtn) centerPlayBtn.addEventListener('click', togglePlay);
  if (ctrlPlayBtn) ctrlPlayBtn.addEventListener('click', togglePlay);

