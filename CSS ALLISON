  box-shadow: 4px 4px 0px #1e293b;
}

/* Interactive Calendar Widget (Idéntico al del wireframe: Oct 2026, día 10 activo, botones CANCEL / OK) */
.calendar-widget-card {
  border: 2px solid #1e293b;
  border-radius: var(--radius-sm);
  background: #f8fafc;
  padding: 1.25rem;
  box-shadow: 3px 3px 0px #1e293b;
  margin-top: 0.5rem;
}

.calendar-top-header {
  border-bottom: 1.5px solid #cbd5e1;
  padding-bottom: 0.75rem;
  margin-bottom: 0.75rem;
}

.calendar-year-label {
  font-size: 0.8rem;
  color: var(--text-muted);
  font-weight: 600;
}

.calendar-selected-title {
  font-size: 1.4rem;
  font-weight: 800;
  color: #1e293b;
}

.calendar-nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.cal-month-nav-btn {
  font-size: 1.1rem;
  font-weight: bold;
  padding: 0.2rem 0.5rem;
}

.cal-month-name {
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.5px;
}

.calendar-days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.3rem;
  text-align: center;
}

.cal-header-day {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--text-muted);
  padding: 0.3rem 0;
}

.cal-day-cell {
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.88rem;
  font-weight: 600;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.15s;
}

.cal-day-cell:hover:not(.disabled) {
  background: #e2e8f0;
}

.cal-day-cell.active-day {
  background: #3b82f6;
  color: white;
  font-weight: 800;
}

.cal-day-cell.disabled {
  color: #cbd5e1;
  cursor: not-allowed;
}

/* Time Slot Selection */
.calendar-time-slots {
  margin-top: 1rem;
  border-top: 1px dashed #cbd5e1;
  padding-top: 0.75rem;
}

.time-slots-label {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--text-muted);
  margin-bottom: 0.4rem;
}

.time-slots-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.time-pill {
  padding: 0.3rem 0.6rem;
  border: 1.5px solid #1e293b;
  border-radius: 4px;
  background: white;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
}

.time-pill.selected {
  background: var(--primary);
  color: white;
}

.calendar-footer-actions {
  display: flex;
  justify-content: flex-end;
  gap: 1.5rem;
  margin-top: 1.25rem;
  padding-top: 0.75rem;
  border-top: 1.5px solid #cbd5e1;
}

.cal-action-btn {
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.5px;
  color: #3b82f6;
}

.cal-action-btn.cancel {
  color: #64748b;
}

.confirm-booking-btn {
  padding: 0.9rem 1.5rem;
  border: 2px solid #1e293b;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: white;
  font-size: 1.1rem;
  font-weight: 800;
  box-shadow: 4px 4px 0px #1e293b;
  transition: all 0.15s;
  margin-top: 0.5rem;
}

.confirm-booking-btn:hover {
  background: var(--primary-hover);
  transform: translate(-1px, -1px);
}

/* ==========================================================================
   FOOTER (Encuéntrame en mis redes)
   ========================================================================== */
.site-footer {
  background: white;
  border-top: 2px solid #1e293b;
  padding: 2.5rem 0;
  margin-top: 4rem;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
}

.footer-socials-title {
  font-size: 1.35rem;
  font-weight: 800;
  color: #1e293b;
}

.footer-social-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.footer-icon-link {
  width: 46px;
  height: 46px;
  border: 2px solid #1e293b;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  color: #1e293b;
  box-shadow: 2px 2px 0px #1e293b;
  transition: all 0.15s;
}

.footer-icon-link:hover {
  transform: translate(-1px, -1px);
