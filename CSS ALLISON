}

/* Date input picker wireframe match */
.input-with-icon {
  position: relative;
  display: flex;
  align-items: center;
}

.input-icon-btn {
  position: absolute;
  right: 12px;
  color: #1e293b;
  font-size: 1.1rem;
}

/* WhatsApp Direct CTA como en wireframe */
.whatsapp-booking-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  background-color: var(--whatsapp);
  color: white;
  font-size: 1.05rem;
  font-weight: 800;
  padding: 0.85rem 1.25rem;
  border: 2px solid #1e293b;
  border-radius: var(--radius-sm);
  box-shadow: 3px 3px 0px #1e293b;
  transition: all 0.15s;
  width: 100%;
}

.whatsapp-booking-btn:hover {
  background-color: var(--whatsapp-hover);
