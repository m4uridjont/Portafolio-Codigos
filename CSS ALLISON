  flex-direction: column;
  gap: 1.1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.form-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-label {
  font-weight: 700;
  font-size: 0.92rem;
  color: #1e293b;
}

.form-input, .form-select {
  width: 100%;
  padding: 0.65rem 0.9rem;
