}

/* Toast Notification */
.toast-notice {
  position: fixed;
  bottom: 25px;
  right: 25px;
  background: #1e293b;
  color: white;
  padding: 0.85rem 1.4rem;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 0.92rem;
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  z-index: 3000;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  opacity: 0;
  transform: translateY(15px);
  transition: all 0.25s ease;
  pointer-events: none;
}

.toast-notice.show {
  opacity: 1;
  transform: translateY(0);
}

/* ==========================================================================
   RESPONSIVE DESIGN (Móviles y Tablets)
   ========================================================================== */
@media (max-width: 900px) {
  .home-hero-grid,
  .benefits-grid,
  .service-zigzag-row,
  .service-zigzag-row.reverse,
  .product-showcase-box,
  .events-grid,
  .about-hero-grid,
  .faq-grid,
  .socials-section-grid,
  .booking-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .service-zigzag-row.reverse {
    direction: ltr;
  }

  .main-nav {
    display: none;
  }

  .mobile-nav-toggle {
    display: block;
  }

  .mobile-menu-drawer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background: white;
    border-bottom: 2px solid #1e293b;
  }

  .form-row-2 {
