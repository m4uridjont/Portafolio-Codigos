  flex-direction: column;
  gap: 1.25rem;
}

.cart-item-card {
  border: 1.5px solid #1e293b;
  border-radius: var(--radius-sm);
  padding: 1rem;
  display: flex;
  gap: 1rem;
  align-items: center;
  background: #fdfdfd;
}

.cart-item-img {
  width: 64px;
  height: 64px;
  object-fit: cover;
  border: 1.5px solid #1e293b;
  border-radius: 4px;
}

.cart-item-info {
  flex: 1;
}

.cart-item-name {
  font-size: 0.95rem;
  font-weight: 700;
  color: #1e293b;
}

.cart-item-price {
  font-weight: 800;
  color: var(--primary);
  font-size: 0.9rem;
}

.cart-qty-ctrls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.4rem;
}

.qty-btn {
  width: 24px;
  height: 24px;
  border: 1px solid #1e293b;
  border-radius: 4px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-footer {
  padding: 1.5rem;
  border-top: 2px solid #1e293b;
  background: var(--bg-subtle);
