}

.location-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.gps-btn {
  padding: 0.45rem 0.9rem;
  border: 1.5px solid #1e293b;
  border-radius: var(--radius-sm);
  background: var(--bg-subtle);
  font-size: 0.85rem;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  box-shadow: 2px 2px 0px #1e293b;
