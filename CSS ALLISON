  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-title {
  font-size: 1.25rem;
  font-weight: 800;
}

.cart-close-btn {
  width: 32px;
  height: 32px;
  border: 1.5px solid #1e293b;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.cart-items-container {
