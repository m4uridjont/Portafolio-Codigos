.cart-total-row {
  display: flex;
  justify-content: space-between;
  font-size: 1.2rem;
  font-weight: 800;
}

.checkout-btn {
  width: 100%;
  padding: 0.85rem;
  border: 2px solid #1e293b;
  border-radius: var(--radius-sm);
  background: var(--whatsapp);
  color: white;
  font-weight: 800;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  box-shadow: 2px 2px 0px #1e293b;
